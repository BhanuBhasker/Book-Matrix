# Copy this file to .env and fill in your own values. .env is git-ignored.
# Spring Boot reads it automatically (spring.config.import in application.properties).

# --- MySQL connection used by the running application -----------------------
DB_URL=jdbc:mysql://127.0.0.1:3306/bookmatrix_dev?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=bookmatrix
DB_PASSWORD=change-me

# --- Separate database used ONLY by `mvn test` (it is wiped between test classes) ---
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/bookmatrix_test?useSSL=false&allowPublicKeyRetrieval=true

# --- First administrator: created on start-up only if no admin exists yet ---
BOOKMATRIX_ADMIN_NAME=Site Administrator
BOOKMATRIX_ADMIN_EMAIL=admin@example.com
BOOKMATRIX_ADMIN_PASSWORD=choose-a-strong-password-1

# Optional
# PORT=8080
# COOKIE_SECURE=true       # set when serving over HTTPS
# BACKUP_DIR=backups
